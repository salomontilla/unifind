<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme configurado con Material 3 y la identidad de Unifind -->
    <style name="Base.Theme.Frontunifind" parent="Theme.Material3.Light.NoActionBar">
        <!-- Colores Primarios y Secundarios -->
        <item name="colorPrimary">@color/brand_blue_primary</item>
        <item name="colorPrimaryVariant">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_yellow_gold</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Fondos y Superficies -->
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="colorSurface">@color/bg_surface_white</item>
        <item name="colorOnSurface">@color/text_title</item>

        <!-- Barra de Estado (Status Bar) -->
        <item name="android:statusBarColor">@color/brand_navy_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Frontunifind" parent="Base.Theme.Frontunifind" />

    <!-- Estilos específicos de componentes para sustentación -->
    <!-- Estilo de Botón Primario con Bordes Redondeados -->
    <style name="Widget.Unifind.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_blue_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/corner_radius_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Estilo de CardView Institucional con Elevación Sutil y Bordes Suaves -->
    <style name="Widget.Unifind.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_large</item>
        <item name="cardElevation">@dimen/elevation_card_low</item>
        <item name="cardBackgroundColor">@color/bg_surface_white</item>
        <item name="strokeColor">@color/stroke_card</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Estilo para Bottom Sheet Modal -->
    <style name="Widget.Unifind.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.Unifind.LargeCornerTop</item>
        <item name="backgroundTint">@color/bg_surface_white</item>
    </style>

    <style name="ShapeAppearance.Unifind.LargeCornerTop" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Estilos de tipografía para ítems del Bottom Navigation -->
    <style name="TextAppearance.Unifind.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_blue_primary</item>
    </style>

    <style name="TextAppearance.Unifind.BottomNav.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
