<?xml version="1.0" encoding="utf-8"?>
<!-- ========================================================================= -->
<!-- PANTALLA 6: CHAT PRIVADO Y COORDINACIÓN DE ENTREGA KIME                   -->
<!-- Arquitectura: CoordinatorLayout + NestedScrollView + Fixed Input Bar      -->
<!-- Justificación de Sustentación:                                            -->
<!-- 1. Interfaz conversacional con separación de estilos de burbuja           -->
<!--    (entrante / saliente) y timestamps con estado de lectura (double-check).-->
<!-- 2. Tarjeta superior de Punto Seguro con botón de acción inmediata.        -->
<!-- ========================================================================= -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ======================================================== -->
        <!-- TOOLBAR SUPERIOR DEL CHAT                                -->
        <!-- ======================================================== -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/brand_navy_dark"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBackChat"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Atrás"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <!-- Avatar del Usuario con Punto Online Verde -->
            <RelativeLayout
                android:id="@+id/layoutChatAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/btnBackChat"
                android:background="@drawable/bg_badge_blue">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/white" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/bg_badge_green" />
            </RelativeLayout>

            <!-- Info del Usuario y Objeto -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/layoutChatAvatar"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_user_name"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_verified"
                        app:tint="@color/brand_yellow_gold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculadora de Ing..."
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Badge "En Coordinación" y Escudo -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_yellow"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/chat_status_coordination"
                    android:textColor="@color/brand_navy_dark"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/white" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Contenedor Desplazable del Chat -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp">

                <!-- ==================================================== -->
                <!-- BANNER DE PUNTO SEGURO KIME                          -->
                <!-- ==================================================== -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Unifind.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeColor="@color/brand_yellow_gold">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/brand_yellow_light"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_pin"
                                    app:tint="@color/brand_navy_dark" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/chat_kime_safe_point_title"
                                    android:textColor="@color/brand_navy_dark"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_chip_outline"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="@string/chat_kime_appointment"
                                android:textColor="@color/brand_navy_dark"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/chat_kime_location"
                            android:textColor="@color/text_body"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConfirmDeliveryChat"
                            style="@style/Widget.Unifind.Button.Primary"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:backgroundTint="@color/brand_green_success"
                            android:text="@string/chat_btn_confirm_delivery"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_check"
                            app:iconGravity="textStart"
                            app:iconSize="16dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tarjeta Protocolo Custodia Kime -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Unifind.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chat_custody_protocol_title"
                            android:textColor="@color/brand_navy_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/chat_custody_protocol_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Píldora de Validación Superada -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_security_blue"
                    android:gravity="center"
                    android:paddingVertical="6dp"
                    android:text="✔ Validación Superada: Número de serie posterior verificado"
                    android:textColor="@color/brand_navy_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Separador de Tiempo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_chip_outline"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Hoy, 2:15 PM"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <!-- ==================================================== -->
                <!-- BURBUJAS DE CONVERSACIÓN                             -->
                <!-- ==================================================== -->

                <!-- Mensaje 1: Entrante (Otro Usuario - EU) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip_outline"
                        android:gravity="center"
                        android:text="EU"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="40dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_bubble_incoming"
                            android:lineSpacingExtra="3dp"
                            android:padding="12dp"
                            android:text="¡Hola! Muchísimas gracias por reportarla. Estaba muy angustiado por el examen de cálculo vectorial de mañana. La calculadora tiene una calcomanía desgastada del logo de ingeniería en la tapa protectora."
                            android:textColor="@color/text_title"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="2:16 PM • Verificado con @uniautonoma.edu.co"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Mensaje 2: Saliente (Tú / Azul) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:background="@drawable/bg_bubble_outgoing"
                        android:lineSpacingExtra="3dp"
                        android:padding="12dp"
                        android:text="Hola compañero, sí, confirmo que tiene esa calcomanía en la cubierta azul marino. La encontré en el mesón del laboratorio 204 después de la clase de las 11."
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="2:19 PM ✔✔"
                        android:textColor="@color/brand_blue_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Mensaje 3: Entrante (Otro Usuario) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_chip_outline"
                        android:gravity="center"
                        android:text="EU"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="40dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_bubble_incoming"
                            android:lineSpacingExtra="3dp"
                            android:padding="12dp"
                            android:text="¡Qué alivio enorme! ¿Te queda bien vernos a las 3:00 PM en las mesas frente a la cafetería del Bloque A? Tengo clase libre hasta las 4:00."
                            android:textColor="@color/text_title"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="2:21 PM"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Mensaje 4: Saliente (Tú / Azul) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="40dp"
                        android:background="@drawable/bg_bubble_outgoing"
                        android:lineSpacingExtra="3dp"
                        android:padding="12dp"
                        android:text="Perfecto, ya acepté la solicitud del Punto Seguro en Kime. Estaré con camisa blanca cerca del módulo de atención de Bienestar. ¡Nos vemos allá a las 3:00 PM!"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="2:23 PM ✔✔"
                        android:textColor="@color/brand_blue_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Banner Recompensa de Honor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_security_yellow"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_trophy" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/chat_honor_reward_notice"
                        android:textColor="@color/brand_navy_dark"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ======================================================== -->
        <!-- BARRA DE ENTRADA DE MENSAJES (BOTTOM INPUT BAR)           -->
        <!-- ======================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_surface_white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <ImageView
                android:id="@+id/btnAttachCamera"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Cámara"
                android:src="@drawable/ic_camera"
                app:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/btnAttachLocation"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Ubicación"
                android:src="@drawable/ic_pin"
                app:tint="@color/text_secondary" />

            <!-- Input de Texto con Candado -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_rounded_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etChatMessage"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/chat_input_hint"
                    android:inputType="textCapSentences"
                    android:textColor="@color/text_title"
                    android:textColorHint="@color/text_muted"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <!-- Botón Enviar -->
            <ImageView
                android:id="@+id/btnSendMessage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_blue"
                android:contentDescription="Enviar"
                android:padding="10dp"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
